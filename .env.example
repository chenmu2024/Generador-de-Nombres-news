# Optional: Google AdSense. Leave blank until the site/account is ready.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# Optional: first-party analytics collector endpoint.
# Leave blank to keep events inside the browser only (CustomEvent + dataLayer).
# If configured, only action metadata and page paths are sent; user-entered names,
# search text, generated names and favorite contents are intentionally excluded.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
