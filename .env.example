# Optional: Google AdSense. Leave blank until the site/account is ready.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# Optional override for the first-party analytics collector endpoint.
# Leave blank to use the same-origin default: /api/analytics.
# Only action metadata, page paths and performance metric values are sent;
# user-entered names, search text, generated names and favorite contents are excluded.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
